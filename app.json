{
  "expo": {
    "name": "egsm",
    "slug": "gruup",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gruup.social",
      "infoPlist": {
        "NSCameraUsageDescription": "Gruup needs camera access so you can take photos and videos for posts and chat.",
        "NSMicrophoneUsageDescription": "Gruup needs microphone access so you can record voice messages.",
        "NSPhotoLibraryUsageDescription": "Gruup needs photo library access so you can share photos and videos."
      }
    },
    "android": {
      "package": "com.gruup.social",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050A0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gruup needs photo library access to let you share images.",
          "cameraPermission": "Gruup needs camera access to let you take photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "49bcd06f-ddf8-4c7f-9b55-ea29f91ba068"
      }
    }
  }
}